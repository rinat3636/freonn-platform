# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_PUBLIC_URL=http://localhost:3000

# ─── Database (MySQL) ────────────────────────────────────────────────────────
DATABASE_URL=mysql://freonn:freonn@localhost:3306/freonn_platform

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_min_32_chars

# ─── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ─── Notifications (MAX bot) ───────────────────────────────────────────────────
MAX_BOT_TOKEN=

# ─── AI (Groq) ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ─── Cameras / go2rtc ──────────────────────────────────────────────────────────
# Internal go2rtc API (server → go2rtc container)
GO2RTC_API_URL=http://localhost:1984
# Public go2rtc URL used by browser for HLS streams
GO2RTC_PUBLIC_URL=http://localhost:1984
