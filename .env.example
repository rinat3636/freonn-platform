# ─── Runtime (сервер + Vite в dev) ───────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── База данных (Drizzle) ───────────────────────────────────────────────────
DATABASE_URL=

# ─── Сессии и OAuth (встроенный портал) ────────────────────────────────────────
# Секрет подписи JWT сессии (обязательно в production)
JWT_SECRET=
# URL OAuth-сервера портала (сервер обменивает code → token)
OAUTH_SERVER_URL=
# OpenID владельца (админ) — см. документацию портала
OWNER_OPEN_ID=

# ─── Freonn Group API (единый аккаунт, заявки в приложении, push) ─────────────
VITE_FREONN_API_BASE_URL=https://freonn-group-app-production.up.railway.app

# ─── Идентификатор приложения (Vite: VITE_* попадает в клиентский бандл) ───────
VITE_APP_ID=
# URL страницы логина портала (клиент)
VITE_OAUTH_PORTAL_URL=

# ─── Forge / карта (клиент — только публичные ключи) ───────────────────────────
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

# ─── Forge / карта (сервер — секреты, не префикс VITE_) ────────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ─── Уведомления (MAX Bot) ─────────────────────────────────────────────────────
# Токен бота MAX — для доставки заявок с сайта и уведомлений о КП
MAX_BOT_TOKEN=

# ─── AI / Groq ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
# Optional: route Groq calls through a proxy (e.g. a Cloudflare Worker) when the
# host region is geo-blocked by Groq. Leave empty to call Groq directly.
GROQ_API_URL=
GROQ_PROXY_SECRET=

# ─── WebSteel (ПК Веста) — серверная оценка по габаритам (Puppeteer) ──────────
# Включить: 1, true, yes
WEBSTEEL_ENABLED=
# Клиент подхватывает флаг через GET /api/config

# ─── SEO (сервер: sitemap lastmod для «пакетных» URL) ───────────────────────────
# Формат YYYY-MM-DD — поднимает lastmod у массовых URL при деплое без правок блога
# SEO_CONTENT_REVISION=2026-06-07

# ─── Прочее ───────────────────────────────────────────────────────────────────
# Опционально: зарезервировано под принудительный live на клиенте (если появится в коде)
# VITE_WEBSTEEL_LIVE=true
